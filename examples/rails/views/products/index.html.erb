<% content_for :title, "商品一覧" %>
<h1>商品一覧</h1>
<p><%= link_to "標準の一覧", products_path %> /
  <%= link_to "テーブル版", products_path(layout: "table") %></p>

<% if params[:layout] == "table" %>
  <div class="yapr-table-wrap" role="region" aria-label="商品テーブル" tabindex="0">
    <table>
      <caption>商品情報</caption>
      <thead>
        <tr><th scope="col">商品名</th><th scope="col">価格</th><th scope="col">取扱い</th><th scope="col">編集</th></tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row"><%= @product.name %></th>
          <td><%= @product.price %> 円</td>
          <td><%= @product.available ? "あり" : "なし" %></td>
          <td><%= link_to "編集", edit_product_path %></td>
        </tr>
      </tbody>
    </table>
  </div>
<% else %>
  <%# Rails 8 の scaffold に合わせた div 一覧。table は置換必須ではない。 %>
  <div id="products">
    <div id="product_demo">
      <p><strong>商品名:</strong> <%= @product.name %></p>
      <p><strong>価格:</strong> <%= @product.price %> 円</p>
      <p><strong>取扱い:</strong> <%= @product.available ? "あり" : "なし" %></p>
    </div>
    <p><%= link_to "編集", edit_product_path %></p>
  </div>
<% end %>
